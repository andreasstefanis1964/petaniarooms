            "@media (min-width: 1400px)": {
              ".col-12": {
                "padding": "0 2rem"
              },
              ".row": {
                "margin": "0 -2rem"
              }
            },
            ".wrapper": {
              "border": "2px solid @primaryColor",
              "padding": "3rem 2rem",
              "@media (max-width: 767px)": {
                "padding": "4rem 1rem"
              }
