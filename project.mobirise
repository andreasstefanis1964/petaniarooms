              },
              "fill": "@primaryColor"
            },
            "@keyframes svg-wave": {
              "from": {
                "transform": "scaleX(1) scaleY(1.1)"
              },
              "to": {
                "transform": "scaleX(1) scaleY(1.6)"
              }
            },
            ".mbr-section-title": {
              "color": "#1a449a"
            },
            "@media (min-width: 1400px)": {
              ".col-12": {
                "padding": "0 2rem"
              },
              ".row": {
                "margin": "0 -2rem"
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#1a449a"
            }
          },
          "_name": "content01",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content1\" group=\"Atricle\" mbr-class=\"{'mbr-fullscreen': fullScreen}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline name=\"imageWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f8f8f8\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <svg class=\"svg-top\" version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\" viewBox=\"0 0 1600 40\" style=\"enable-background:new 0 0 1600 40;\" preserveAspectRatio=\"none\">\n        <style type=\"text/css\">\n            .st0 {\n                fill: #1A449A;\n            }\n        </style>\n        <path class=\"st0\" d=\"M-1,15.7c200.1,0,200.7,13.8,400.9,13.8C600,29.5,600.4,9.3,800.5,9.3S998.8,36.8,1199,36.8\n\ts201.9-21.1,402-21.1v24.1L-1,40V15.7z\"></path>\n    </svg>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md-12 col-lg-{{imageWidth}} image-wrapper m-auto\">\n                <img class=\"w-100 md-pb\" src=\"@PROJECT_PATH@/assets/images/5e6a8759.jpg-998x1497.jpg\" alt=\"Mobirise\">\n            </div>\n            <div class=\"col-12 col-md-12 col-lg m-auto\">\n                <div class=\"text-wrapper align-left\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>About Petania Hotel Lixouri in Kefalonia</b></h1>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Our hotel is a good \"Low budget option\" for your vacations with your friends in one of our double, twin or triple rooms. Our one-room studios with kitchen and balcony on the 2st floor are ideal for small families up to 4 persons (1 double bed, 2 single beds).<br><br>From our location you need around a ten minute walk to the town centre of Lixouri or to the nearest city beach. A visit to Kefalonia is not just a vacation — it's an experience of a lifetime.&nbsp;Explore the island's historical sites, such as the Venetian Castle of Assos.<br>\n                        <br>While Argostoli is the capital of Kefalonia, Lixouri offers a more tranquil and authentic Greek island experience.<br><br></p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-lg btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">READ MORE</a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sBUf7bgybF",
          "_anchor": "content01-4",
          "_sourceTheme": "beveragem5",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              ".svg-top": {
                "display": "none"
              }
            },
            ".team-card": {
              "margin-bottom": "2rem",
              "transition": "all 0.3s",
              "&:hover": {
                "transform": "translateY(-10px)"
              }
            },
            ".more": {
              "transform": "scale(0) translate(-50%, -50%)",
              "transition": "all 0.3s",
              "position": "absolute",
              "top": "50%",
              "left": "50%"
            },
            ".image-wrap": {
              "position": "relative",
              "height": "350px",
              "cursor": "pointer",
              "padding-bottom": "1rem",
              "img": {
                "height": "100%",
                "object-fit": "cover"
              },
              "&:hover, &:focus-within": {
                ".read, .img-svg": {
                  "opacity": "1",
                  "transform": "scale(1) translate(-50%, -50%)"
                },
                ".more": {
                  "transform": "scale(1)"
                }
              },
              "@media (max-width: 767px)": {
                ".read, .img-svg": {
                  "opacity": "1",
                  "transform": "scale(1) translate(-50%, -50%)"
                },
                ".more": {
                  "transform": "scale(1)"
                }
              }
            },
            ".read": {
              "transform": "translate(-50%, -50%)",
              "position": "absolute",
              "top": "50%",
              "left": "50%",
              "width": "50px",
              "transition": "all 0.3s",
              "z-index": "3",
              "color": "#ffffff",
              "opacity": "0",
              "text-align": "center"
            },
            ".img-svg": {
              "transition": "all 0.3s",
              "opacity": "0",
              "transform": "translate(-50%, -50%)",
              "path": {
                "fill": "@primaryColor"
              },
              "position": "absolute",
              "z-index": "2",
              "top": "50%",
              "fill": "@primaryColor",
              "left": "50%",
              "animation": "1s ease-in-out infinite alternate curs"
            },
            "@keyframes curs": {
              "from": {
                "transform": "translate(-50%, -50%) skew(3deg, 0deg) scale(1)"
              },
              "to": {
                "transform": "translate(-50%, -50%) skew(-3deg, 0deg) scale(0.95)"
              }
            },
            ".svg-top": {
              "width": "100%",
              "position": "absolute",
              "left": "0",
              "top": "-48px",
              "height": "50px",
              "transform-origin": "bottom",
              "animation": "1.5s ease-in-out infinite alternate svg-wave",
              ".st0": {
                "fill": "@bg-value"
              },
              "@media (max-width: 992px)": {
                "width": "1000px"
              },
              "fill": "@primaryColor"
            },
            "@keyframes svg-wave": {
              "from": {
                "transform": "scaleX(1) scaleY(1.1)"
              },
              "to": {
                "transform": "scaleX(1) scaleY(1.6)"
              }
            },
            "@keyframes line": {
              "0%": {
                "transform": "scaleX(1)"
              },
              "50%": {
                "transform": "scaleX(0)"
              },
              "100%": {
                "transform": "scaleX(1)"
              }
            },
            "h5": {
              "position": "relative",
              "display": "inline-block",
              "width": "fit-content",
              "&:before": {
                "content": "''",
                "position": "absolute",
                "right": "-65px",
                "top": "50%",
                "transform-origin": "left",
                "height": "2px",
                "width": "45px",
                "background": "currentColor"
              }
            },
            ".card-wrap": {
              "@media (max-width: 991px)": {
                "margin-bottom": "2rem"
              },
              ".image-wrap img": {
                "width": "100%",
                "margin-bottom": "1rem"
              },
              "&:hover": {
                "h5": {
                  "&:before": {
                    "animation": "1s ease-in-out alternate line"
                  }
                }
              }
            },
            ".card-title, .social-row": {
              "color": "#1a449a"
            },
            ".mbr-role, .social-row": {
              "color": "#ffffff"
            },
            ".card-text, .mbr-section-btn, .social-row": {
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".card-title, .content-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff"
            }
          },
          "_name": "features03",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features3\" group=\"Features\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"7\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showName\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showRole\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showCardButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#1a449a\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <svg width=\"100\" height=\"100\" class=\"svg-top\" version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\" viewBox=\"0 0 1600 40\" style=\"enable-background:new 0 0 1600 40;\" preserveAspectRatio=\"none\">\n        <style type=\"text/css\">\n            .st0 {\n                fill: #1A449A;\n            }\n        </style>\n        <path class=\"st0\" d=\"M-1,15.7c200.1,0,200.7,13.8,400.9,13.8C600,29.5,600.4,9.3,800.5,9.3S998.8,36.8,1199,36.8\n\ts201.9-21.1,402-21.1v24.1L-1,40V15.7z\"></path>\n    </svg>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n\n            <div class=\"col-lg-3 col-md-6 md-pb\" mbr-if=\"showTitle || showText\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-left mb-3\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>News</b></h3>\n                <p class=\"mbr-section-subtitle mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-subtitle\">\n                    Text</p>\n            </div>\n\n\n            <div class=\"col-sm-6 col-lg-3\" mbr-if=\"cardsAmount > 0\">\n                <div class=\"card-wrap\">\n                    <div class=\"image-wrap\">\n                        <div class=\"more\">\n                            <svg class=\"img-svg\" width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\" version=\"1.0\">\n                                <g>\n                                    <path stroke=\"#000\" fill=\"#00ffff\" stroke-width=\"0\" d=\"m6.3597,35.19471c3.72928,-14.92599 8.15276,-26.3096 24.79653,-31.20482c16.64376,-4.89522 47.61714,-4.17429 56.63326,15.6024c9.01612,19.77669 10.43127,65.01743 -7.40514,73.44612c-17.83641,8.42869 -52.82388,8.41088 -62.93475,-7.63655c-10.11087,-16.04743 -15.58461,-25.33055 -12.23805,-47.14544l1.14815,-3.06171z\" id=\"svg_3\"></path>\n                                </g>\n                            </svg>\n                            <p class=\"read mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" data-app-selector=\".read\">More</p>\n                        </div>\n                        <img src=\"@PROJECT_PATH@/assets/images/features2.jpg\">\n                    </div>\n                    <div class=\"content-wrap\">\n                        <h6 class=\"mbr-role mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                            25.07.21</h6>\n                        <h5 class=\"mbr-section-title card-title mbr-fonts-style align-left m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .content-wrap\">Our Beverages</h5>\n\n                        <p class=\"card-text mbr-fonts-style align-left\" data-app-selector=\".card-text, .mbr-section-btn, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\">\n                            Text</p>\n\n                        <div class=\"mbr-section-btn card-btn align-left\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-if=\"showCardButtons\" mbr-theme-style=\"display-4\"><a class=\"btn btn-lg btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Read More</a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-sm-6 col-lg-3\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrap\">\n                    <div class=\"image-wrap\">\n                        <div class=\"more\">\n                            <svg class=\"img-svg\" width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\" version=\"1.0\">\n                                <g>\n                                    <path stroke=\"#000\" fill=\"#00ffff\" stroke-width=\"0\" d=\"m6.3597,35.19471c3.72928,-14.92599 8.15276,-26.3096 24.79653,-31.20482c16.64376,-4.89522 47.61714,-4.17429 56.63326,15.6024c9.01612,19.77669 10.43127,65.01743 -7.40514,73.44612c-17.83641,8.42869 -52.82388,8.41088 -62.93475,-7.63655c-10.11087,-16.04743 -15.58461,-25.33055 -12.23805,-47.14544l1.14815,-3.06171z\" id=\"svg_3\"></path>\n                                </g>\n                            </svg>\n                            <p class=\"read mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" data-app-selector=\".read\">More</p>\n                        </div>\n                        <img src=\"@PROJECT_PATH@/assets/images/features3.jpg\">\n                    </div>\n                    <div class=\"content-wrap\">\n                        <h6 class=\"mbr-role mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                            27.07.21</h6>\n                        <h5 class=\"mbr-section-title card-title mbr-fonts-style align-left m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .content-wrap\">Special Fresh</h5>\n\n                        <p class=\"card-text mbr-fonts-style align-left\" data-app-selector=\".card-text, .mbr-section-btn, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\">Text</p>\n\n                        <div class=\"mbr-section-btn card-btn align-left\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-if=\"showCardButtons\" mbr-theme-style=\"display-4\"><a class=\"btn btn-lg btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Read More</a></div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-sm-6 col-lg-3\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrap\">\n                    <div class=\"image-wrap\">\n                        <div class=\"more\">\n                            <svg class=\"img-svg\" width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\" version=\"1.0\">\n                                <g>\n                                    <path stroke=\"#000\" fill=\"#00ffff\" stroke-width=\"0\" d=\"m6.3597,35.19471c3.72928,-14.92599 8.15276,-26.3096 24.79653,-31.20482c16.64376,-4.89522 47.61714,-4.17429 56.63326,15.6024c9.01612,19.77669 10.43127,65.01743 -7.40514,73.44612c-17.83641,8.42869 -52.82388,8.41088 -62.93475,-7.63655c-10.11087,-16.04743 -15.58461,-25.33055 -12.23805,-47.14544l1.14815,-3.06171z\" id=\"svg_3\"></path>\n                                </g>\n                            </svg>\n                            <p class=\"read mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" data-app-selector=\".read\">More</p>\n                        </div>\n                        <img src=\"@PROJECT_PATH@/assets/images/features4.jpg\">\n                    </div>\n                    <div class=\"content-wrap\">\n                        <h6 class=\"mbr-role mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                            28.07.21</h6>\n                        <h5 class=\"mbr-section-title card-title mbr-fonts-style align-left m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .content-wrap\">Top Cocktails</h5>\n\n                        <p class=\"card-text mbr-fonts-style align-left\" data-app-selector=\".card-text, .mbr-section-btn, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\">\n                            Text</p>\n\n                        <div class=\"mbr-section-btn card-btn align-left\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-if=\"showCardButtons\" mbr-theme-style=\"display-4\"><a class=\"btn btn-lg btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Read More</a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
